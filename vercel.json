{
  "cleanUrls": false,
  "trailingSlash": false,
  "regions": ["sin1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "tanggaltua.com" }],
      "destination": "https://tanggaltua.id/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tanggaltua.com" }],
      "destination": "https://tanggaltua.id/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.tanggaltua.id" }],
      "destination": "https://tanggaltua.id/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/en", "destination": "/en/index.html" },
    { "source": "/en/", "destination": "/en/index.html" },
    { "source": "/talangin", "destination": "/talangin/index.html" },
    { "source": "/talangin/", "destination": "/talangin/index.html" },
    { "source": "/komunitas", "destination": "/komunitas/index.html" },
    { "source": "/komunitas/", "destination": "/komunitas/index.html" },
    { "source": "/play", "destination": "/play/index.html" },
    { "source": "/play/", "destination": "/play/index.html" },
    { "source": "/play/a", "destination": "/play/a/index.html" },
    { "source": "/play/b", "destination": "/play/b/index.html" },
    { "source": "/play/c", "destination": "/play/c/index.html" },
    { "source": "/panduan", "destination": "/panduan.html" },
    { "source": "/press", "destination": "/press.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/(llms\\.txt|llms-full\\.txt)",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=300" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Vary", "value": "Accept" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
